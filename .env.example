# ClickFlare Configuration
# Copy this file to .env and fill in your values

# Your ClickFlare tracker domain (without https://)
# Example: tracker.yourdomain.com or yoursubdomain.clickflaretracking.com
CLICKFLARE_TRACKER_DOMAIN=your-tracker-domain.com

# API Key (from Settings > Security > API Access)
CLICKFLARE_API_KEY=your-api-key-here

# Use HTTPS (true/false, default: true)
CLICKFLARE_USE_HTTPS=true

# Request timeout in milliseconds (default: 10000)
CLICKFLARE_TIMEOUT=10000

# Timezone for reports (default: UTC)
CLICKFLARE_TIMEZONE=UTC

# Currency for reports (default: USD)
CLICKFLARE_CURRENCY=USD
